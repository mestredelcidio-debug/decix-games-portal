# ==============================================================================
# DECIX GAMES – Configurações de Ambiente
# ==============================================================================

# Porta do servidor backend (Padrão: 3000)
PORT=3000

# URL pública do site (utilizada para SEO, canônicos e sitemap)
PUBLIC_SITE_URL="http://localhost:3000"

# Segredo de autenticação para o painel administrativo e sincronização (/api/admin/*)
# Substitua por uma chave forte em produção.
ADMIN_SECRET="decix_admin_secret_key_2026"

# Integração Oficial GamePix API
# Obtenha sua chave de API e credenciais de publisher no portal GamePix Developers: https://developers.gamepix.com/
GAMEPIX_API_KEY=""
# URL base oficial da API GamePix (por exemplo: https://games.gamepix.com/games)
GAMEPIX_API_URL="https://games.gamepix.com/games"

# Tempo de vida do cache interno da DECIX GAMES em segundos (ex: 3600 = 1 hora)
GAMEPIX_CACHE_TTL=3600

# Chave opcional do Google Gemini AI (caso utilize geração de conteúdo no futuro)
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

